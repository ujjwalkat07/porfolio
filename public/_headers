# Cache Next.js built assets
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Cache public directory assets (images, icons, documents)
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=604800, immutable
/*.webmanifest
  Cache-Control: public, max-age=86400
/*.pdf
  Cache-Control: public, max-age=31536000, immutable

# Cache HTML routes at Cloudflare Edge to prevent cold-start latency
/
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800
/blog
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800
/about
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800
/projects
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800
/contact
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800
